/* ============================================
   KILBOURN — Product detail
   ============================================ */

.product {
  background: var(--paper);
  padding: 40px 0 120px;
}

.crumb {
  font-size: 11px; font-weight: 700; letter-spacing: .18em;
  text-transform: uppercase; color: var(--smoke);
  display: flex; align-items: center; gap: 10px;
  margin-bottom: 40px;
}
.crumb a { transition: color var(--t-fast) var(--ease); }
.crumb a:hover { color: var(--orange); }
.crumb .sep { color: var(--ash); }
.crumb .current { color: var(--ink); }

.product__grid {
  display: grid;
  grid-template-columns: 1.05fr 1fr;
  gap: clamp(40px, 6vw, 80px);
  align-items: start;
}

.product__gallery {
  position: sticky;
  top: calc(var(--topbar-h) + var(--nav-h) + 24px);
  display: flex; flex-direction: column; gap: 16px;
}
.product__hero {
  position: relative;
  aspect-ratio: 1;
  background: var(--ink);
  border-radius: var(--r-lg);
  overflow: hidden;
  isolation: isolate;
}
.product__hero::before {
  content: ""; position: absolute; inset: 0;
  background:
    radial-gradient(50% 50% at 30% 30%, rgba(212,82,10,.28), transparent 60%),
    radial-gradient(40% 40% at 80% 80%, rgba(212,82,10,.14), transparent 60%);
  z-index: 1;
}
.product__hero::after {
  content: ""; position: absolute; inset: 0; z-index: 2;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='1.3' numOctaves='2'/></filter><rect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/></svg>");
  opacity: .07;
  mix-blend-mode: overlay;
  pointer-events: none;
}
.product__wm {
  position: absolute;
  font-family: var(--display);
  font-size: clamp(220px, 30vw, 480px);
  color: var(--cream); opacity: .055;
  bottom: -8%; right: -4%;
  line-height: .8;
  pointer-events: none; z-index: 1;
  letter-spacing: -.02em;
}
.product__hero-logo {
  position: absolute; inset: 0; z-index: 3;
  display: flex; align-items: center; justify-content: center;
  padding: 18%;
  transition: transform .8s var(--ease);
}
.product__hero-logo img {
  width: 100%; height: 100%; object-fit: contain;
  filter: brightness(0) invert(1) drop-shadow(0 24px 60px rgba(212,82,10,.5));
}
.product__hero:hover .product__hero-logo { transform: scale(1.04); }
.product__label {
  position: absolute; top: 24px; left: 24px; z-index: 4;
  font-size: 10px; font-weight: 700; letter-spacing: .22em;
  text-transform: uppercase;
  padding: 8px 12px;
  border-radius: var(--r-pill);
  background: var(--orange); color: var(--cream);
}
.product__corner {
  position: absolute; z-index: 4;
  font-size: 10px; font-weight: 700; letter-spacing: .22em;
  text-transform: uppercase; color: rgba(245,237,216,.55);
}
.product__corner--tr { top: 24px; right: 24px; }
.product__corner--bl { bottom: 24px; left: 24px; }

.product__thumbs {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}
.product__thumb {
  aspect-ratio: 1;
  background: var(--ink-soft);
  border-radius: var(--r-sm);
  display: flex; align-items: center; justify-content: center;
  padding: 18%;
  cursor: pointer;
  border: 1px solid transparent;
  transition: border-color var(--t-fast) var(--ease), transform var(--t-fast) var(--ease);
  position: relative;
  overflow: hidden;
}
.product__thumb::before {
  content: ""; position: absolute; inset: 0;
  background: radial-gradient(circle at 40% 40%, rgba(212,82,10,.15), transparent 60%);
}
.product__thumb img { filter: brightness(0) invert(1); position: relative; z-index: 1; max-width: 100%; max-height: 100%; }
.product__thumb.is-active { border-color: var(--orange); }
.product__thumb:hover { transform: scale(1.04); }

/* ----- Info column ----- */
.product__info { display: flex; flex-direction: column; gap: 22px; }
.product__eyebrow { color: var(--orange); }
.product__eyebrow::before { background: var(--orange); }
.product__name {
  font-family: var(--display);
  font-size: clamp(40px, 6vw, 80px);
  text-transform: uppercase; letter-spacing: -.01em;
  line-height: .92;
  color: var(--ink);
}
.product__desc {
  font-size: clamp(15px, 1.4vw, 17px); line-height: 1.55;
  color: var(--ink-soft);
  max-width: 480px;
}
.product__price-row {
  display: flex; align-items: baseline; gap: 16px;
  padding: 20px 0;
  border-top: 1px solid rgba(37,36,34,.1);
  border-bottom: 1px solid rgba(37,36,34,.1);
}
.product__price {
  font-family: var(--display);
  font-size: 48px; color: var(--ink);
  letter-spacing: -.005em;
}
.product__price-meta {
  font-size: 10.5px; font-weight: 700; letter-spacing: .22em;
  text-transform: uppercase; color: var(--smoke);
}

.product__sizes { display: flex; flex-direction: column; gap: 14px; }
.product__sizes-head {
  display: flex; justify-content: space-between;
  font-size: 10.5px; font-weight: 700; letter-spacing: .22em;
  text-transform: uppercase;
}
.product__sizes-head a { color: var(--smoke); transition: color var(--t-fast) var(--ease); }
.product__sizes-head a:hover { color: var(--orange); }
.product__size-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(60px, 1fr));
  gap: 8px;
}
.product__size {
  padding: 14px 8px;
  border: 1px solid rgba(37,36,34,.18);
  border-radius: var(--r-sm);
  background: transparent;
  font-size: 13px; font-weight: 700; letter-spacing: .12em;
  text-transform: uppercase; color: var(--ink-soft);
  cursor: pointer;
  transition: all var(--t-fast) var(--ease);
}
.product__size:hover { border-color: var(--ink); }
.product__size.is-selected {
  background: var(--ink); color: var(--cream); border-color: var(--ink);
}
.product__size.is-error {
  border-color: var(--orange); color: var(--orange);
  animation: shake .4s var(--ease);
}
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-4px); }
  75% { transform: translateX(4px); }
}
.product__size-error {
  font-size: 11px; color: var(--orange);
  letter-spacing: .12em; text-transform: uppercase; font-weight: 700;
  opacity: 0; transition: opacity var(--t-fast) var(--ease);
  height: 0;
}
.product__size-error.is-visible { opacity: 1; height: auto; }

.product__actions { display: flex; flex-direction: column; gap: 10px; margin-top: 4px; }

/* Accordion */
.accordion { margin-top: 20px; display: flex; flex-direction: column; }
.accordion__item { border-top: 1px solid rgba(37,36,34,.1); }
.accordion__item:last-child { border-bottom: 1px solid rgba(37,36,34,.1); }
.accordion__btn {
  width: 100%;
  display: flex; justify-content: space-between; align-items: center;
  padding: 18px 0;
  font-size: 11px; font-weight: 700; letter-spacing: .22em;
  text-transform: uppercase; color: var(--ink);
  cursor: pointer; text-align: left;
}
.accordion__btn .ico {
  width: 14px; height: 14px;
  display: flex; align-items: center; justify-content: center;
  transition: transform var(--t) var(--ease);
}
.accordion__item.is-open .accordion__btn .ico { transform: rotate(45deg); }
.accordion__body {
  max-height: 0; overflow: hidden;
  transition: max-height var(--t) var(--ease);
  font-size: 14px; color: var(--smoke); line-height: 1.6;
}
.accordion__body-inner { padding: 0 0 20px; }
.accordion__item.is-open .accordion__body { max-height: 240px; }

/* Related */
.related {
  background: var(--paper);
  padding: 60px 0 120px;
  border-top: 1px solid rgba(37,36,34,.08);
}
.related__head {
  display: flex; justify-content: space-between; align-items: flex-end;
  margin-bottom: 40px;
}
.related__title {
  font-family: var(--display);
  font-size: clamp(40px, 5vw, 64px);
  text-transform: uppercase; letter-spacing: -.005em;
}
.related__grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;
}
@media (max-width: 1024px) {
  .product__grid { grid-template-columns: 1fr; }
  .product__gallery { position: static; }
  .related__grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .product__price { font-size: 40px; }
  .related__grid { grid-template-columns: 1fr; }
}
